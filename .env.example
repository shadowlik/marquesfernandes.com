# WordPress source database (read-only) — used by the one-time migration scripts.
# Copy to .env and fill in. .env is gitignored; never commit credentials.
WP_DB_HOST=cname.marquesfernandes.com
WP_DB_PORT=33062
WP_DB_USER=root
WP_DB_PASSWORD=
