---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { getAlternates, resolveCanonicalPath } from '@/lib/translations';
import { stripCategoryPath } from '@/lib/blog';
import { ogImagePath, articleOgRoute } from '@/lib/og';

/**
 * Renders every blog post at its category-less URL — `/<slug>/` (pt),
 * `/en/<slug>/`, `/es/<slug>/`. The old category paths 301 to these via the
 * generated redirect map (see astro.config). The rest param captures the slug.
 */
export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((entry) => ({
    params: {
      path: stripCategoryPath(resolveCanonicalPath(entry.data)).replace(/^\/+|\/+$/g, ''),
    },
    props: {
      entry,
      alternates: getAlternates(entry, posts).map((a) => ({
        lang: a.lang,
        path: stripCategoryPath(a.path),
      })),
    },
  }));
}) satisfies GetStaticPaths;

const { entry, alternates } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BlogPostLayout
  title={d.title}
  description={d.description}
  lang={d.lang}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  category={d.category}
  needsReview={d.needsReview}
  cover={d.cover}
  alternates={alternates}
  ogImage={ogImagePath(articleOgRoute(d.lang, d.translationKey))}
>
  <Content />
</BlogPostLayout>
