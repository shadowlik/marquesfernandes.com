---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  category?: string;
  author?: string;
  date: Date;
  tags?: string[];
  /** Optional featured-image URL for the hero background. */
  cover?: string;
}

const {
  title,
  description,
  lang,
  category,
  author = 'Henrique Marques Fernandes',
  date,
  tags = [],
  cover,
} = Astro.props;
const t = useTranslations(lang);
const formatted = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(date);
const heroStyle = cover ? `background-image: url('${cover}')` : undefined;
---

<BaseLayout title={title} description={description} lang={lang}>
  <header class:list={['post-hero', { 'has-cover': cover }]} style={heroStyle}>
    <div class="container hero-inner">
      {category && <p class="hero-cat">{category}</p>}
      <h1>{title}</h1>
    </div>
  </header>

  <div class="container post-body">
    <aside class="meta">
      <p><span class="eyebrow">{t('post.writtenBy')}</span><br />{author}</p>
      <p><span class="eyebrow">{t('post.postedOn')}</span><br />{formatted}</p>
      {
        tags.length > 0 && (
          <p>
            <span class="eyebrow">{t('post.tags')}</span>
            <br />
            {tags.join(', ')}
          </p>
        )
      }
    </aside>
    <div class="content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .post-hero {
    background: var(--color-ink);
    color: var(--color-on-dark);
    background-size: cover;
    background-position: center;
    padding-block: var(--hero-pad);
    text-align: center;
    position: relative;
  }
  .post-hero.has-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }
  .hero-inner {
    position: relative;
  }
  .hero-cat {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
    color: var(--color-on-dark);
  }
  .post-hero h1 {
    color: var(--color-on-dark);
    margin: 0 auto;
    max-width: 18ch;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  .meta p {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .meta .eyebrow {
    display: inline-block;
    margin-bottom: 0.15rem;
  }
  .content {
    max-width: var(--measure);
  }
  .content :global(h2),
  .content :global(h3) {
    margin-top: 2rem;
  }

  @media (max-width: 720px) {
    .post-body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
