---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  author?: string;
  date: Date;
  tags?: string[];
  /** Show a 'machine-translated, pending review' note. */
  needsReview?: boolean;
  /** Optional featured image for the hero background. */
  cover?: ImageMetadata;
  /** Per-language equivalents for hreflang + the language switcher. */
  alternates?: { lang: Lang; path: string }[];
}

const {
  title,
  description,
  lang,
  author = 'Henrique Marques Fernandes',
  date,
  tags = [],
  needsReview = false,
  cover,
  alternates,
} = Astro.props;
const t = useTranslations(lang);
const formatted = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={description} lang={lang} alternates={alternates}>
  <header class:list={['post-hero', { 'has-cover': cover }]}>
    {
      cover && (
        <Image class="hero-bg" src={cover} alt="" widths={[768, 1280, 1920]} loading="eager" />
      )
    }
    <div class="container hero-inner">
      <h1>{title}</h1>
    </div>
  </header>

  <div class="container post-body">
    <aside class="meta">
      <p><span class="eyebrow">{t('post.writtenBy')}</span><br />{author}</p>
      <p><span class="eyebrow">{t('post.postedOn')}</span><br />{formatted}</p>
      {
        tags.length > 0 && (
          <p>
            <span class="eyebrow">{t('post.tags')}</span>
            <br />
            {tags.join(', ')}
          </p>
        )
      }
    </aside>
    <div class="content">
      {needsReview && <p class="review-note">{t('post.machineTranslated')}</p>}
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .post-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-on-dark);
    min-height: 55vh;
    display: grid;
    place-items: center;
    padding-block: var(--hero-pad);
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-hero.has-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.55);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }
  .post-hero h1 {
    color: var(--color-on-dark);
    margin: 0 auto;
    max-width: 24ch;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  .meta p {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .meta .eyebrow {
    display: inline-block;
    margin-bottom: 0.15rem;
  }
  .content {
    max-width: var(--measure);
  }
  .review-note {
    font-size: 0.9rem;
    padding: 0.6rem 0.9rem;
    margin: 0 0 1.75rem;
    background: #fff5f7;
    border-left: 3px solid var(--color-accent);
    color: var(--color-heading);
  }
  .content :global(h2),
  .content :global(h3) {
    margin-top: 2rem;
  }

  @media (max-width: 720px) {
    .post-body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
