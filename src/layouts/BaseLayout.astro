---
import '@/styles/global.css';
import { type Lang } from '@/i18n/ui';
import { getLangFromUrl } from '@/i18n/utils';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Override the detected locale (e.g. when rendering a fixed-language page). */
  lang?: Lang;
  /** Per-language equivalents for hreflang tags + the language switcher. */
  alternates?: { lang: Lang; path: string }[];
  /** Float a transparent header over a full-bleed hero (homepage). */
  overlayHeader?: boolean;
}

const { title, description, alternates, overlayHeader } = Astro.props;
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const htmlLang = lang === 'pt' ? 'pt-BR' : lang;
const hreflang = (l: Lang) => (l === 'pt' ? 'pt-BR' : l);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      alternates?.map((alt) => (
        <link rel="alternate" hreflang={hreflang(alt.lang)} href={new URL(alt.path, Astro.site)} />
      ))
    }
  </head>
  <body>
    <Header lang={lang} alternates={alternates} overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
