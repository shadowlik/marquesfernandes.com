---
import { languages, defaultLang, type Lang } from '@/i18n/ui';
import { getLangFromUrl } from '@/i18n/utils';

interface Props {
  /** Per-language equivalents of the current page (e.g. a post's siblings). */
  alternates?: { lang: Lang; path: string }[];
}
const { alternates } = Astro.props;
const current = getLangFromUrl(Astro.url);

function homeFor(lang: Lang): string {
  return lang === defaultLang ? '/' : `/${lang}/`;
}

// With alternates (post pages), show only available translations linking to the
// equivalent page; otherwise show all locales linking to their home.
const items: { lang: Lang; href: string }[] = alternates
  ? alternates.map((a) => ({ lang: a.lang, href: a.path }))
  : (Object.keys(languages) as Lang[]).map((lang) => ({ lang, href: homeFor(lang) }));
---

<nav class="lang-switcher" aria-label="Language">
  <ul>
    {
      items.map(({ lang, href }) => (
        <li>
          <a href={href} aria-current={lang === current ? 'true' : undefined} hreflang={lang}>
            {languages[lang]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang-switcher ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-switcher a {
    color: inherit;
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .lang-switcher a[aria-current='true'] {
    font-weight: 700;
    text-decoration: underline;
  }
</style>
