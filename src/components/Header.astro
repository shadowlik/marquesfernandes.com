---
import { type Lang } from '@/i18n/ui';
import { useTranslations, localizedPath } from '@/i18n/utils';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  /** Per-language equivalents of the current page, for the switcher. */
  alternates?: { lang: Lang; path: string }[];
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

const onBlog = /\/blog\/?$/.test(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizedPath('', lang)}>MF.</a>
    <nav class="primary" aria-label="Primary">
      <a href={localizedPath('blog', lang)} aria-current={onBlog ? 'page' : undefined}>
        {t('nav.blog')}
      </a>
    </nav>
    <LanguageSwitcher alternates={alternates} />
  </div>
</header>

<style>
  .site-header {
    background: var(--color-ink);
    color: var(--color-on-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 112px;
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2.25rem;
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-dark);
    transition: color 0.2s ease;
  }
  .brand:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .primary {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }
  .primary a {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-on-dark);
    text-decoration: none;
  }
  /* Underline that animates from 0 -> 100% on hover and stays for the active link. */
  .primary a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    background: var(--color-accent);
    transition: width 0.25s ease;
  }
  .primary a:hover::after,
  .primary a[aria-current='page']::after {
    width: 100%;
  }
</style>
