---
import { type Lang } from '@/i18n/ui';
import { useTranslations, localizedPath } from '@/i18n/utils';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  /** Per-language equivalents of the current page, for the switcher. */
  alternates?: { lang: Lang; path: string }[];
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizedPath('', lang)}>MF.</a>
    <nav class="primary" aria-label="Primary">
      <a href={localizedPath('blog', lang)}>{t('nav.blog')}</a>
    </nav>
    <LanguageSwitcher alternates={alternates} />
  </div>
</header>

<style>
  .site-header {
    background: var(--color-ink);
    color: var(--color-on-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 112px;
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2.25rem;
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-dark);
  }
  .brand:hover {
    text-decoration: none;
  }
  .primary {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }
  .primary a {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-on-dark);
  }
</style>
