---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  size?: 'narrow' | 'content' | 'wide';
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  caption,
  credit,
  size = 'content',
  loading = 'lazy',
} = Astro.props;
---

<figure class:list={['article-figure', `article-figure-${size}`]}>
  <Image
    class="article-figure-image"
    src={src}
    alt={alt}
    layout="constrained"
    widths={[480, 768, 1024, 1440]}
    loading={loading}
  />
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {credit && <small>{credit}</small>}
      </figcaption>
    )
  }
</figure>

<style>
  .article-figure {
    width: 100%;
    margin: 1.75rem auto;
  }
  .article-figure-narrow {
    max-width: 30rem;
  }
  .article-figure-content {
    max-width: var(--measure);
  }
  .article-figure-wide {
    max-width: 72rem;
  }
  .article-figure :global(.article-figure-image) {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 4px;
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.65rem;
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  figcaption small {
    font-size: 0.8rem;
    opacity: 0.75;
  }
</style>
