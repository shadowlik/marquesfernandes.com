---
/**
 * Responsive YouTube embed, used in MDX articles where the legacy WordPress
 * oEmbed rendered an inline player. Pass the video `id` (and optional `list`
 * for playlists). Uses the privacy-friendly youtube-nocookie host and lazy
 * loading so the player only loads when scrolled into view.
 */
interface Props {
  id: string;
  list?: string;
  title?: string;
}
const { id, list, title = 'YouTube video' } = Astro.props;

const params = new URLSearchParams();
if (list) params.set('list', list);
const query = params.toString();
const src = `https://www.youtube-nocookie.com/embed/${id}${query ? `?${query}` : ''}`;
---

<div class="yt">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-block: 1.5rem;
    overflow: hidden;
    border-radius: 4px;
    background: #000;
  }
  .yt iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
