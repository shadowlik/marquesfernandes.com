---

<footer class="site-footer">
  <div class="lets-talk container">
    <h2>{t('footer.letsTalk')}</h2>
    <a class="email" href={`mailto:${email}`}>{email.toUpperCase()}</a>
    <p class="blurb">{t('footer.blurb')}</p>
    <div class="socials">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <svg viewBox={s.viewBox} fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>{t('footer.tagline')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: #1c1c1c;
    color: var(--color-on-dark);
    position: relative;
  }
  /* branded vertical accent line at top center */
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 70px;
    background: var(--color-accent);
  }
  .lets-talk {
    padding-block: 5rem;
  }
  .lets-talk h2 {
    color: var(--color-on-dark);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 2rem;
  }
  .email {
    display: inline-block;
    text-transform: uppercase;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.02em;
    margin-bottom: 1.5rem;
  }
  .blurb {
    max-width: 42ch;
    color: #acacac;
    margin: 0 0 2.5rem;
  }
  .socials {
    display: flex;
    gap: 1rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    color: var(--color-on-dark);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .socials a:hover {
    background: var(--color-accent);
  }
  .socials svg {
    width: 20px;
    height: 20px;
  }
  .footer-bottom {
    background: var(--color-ink);
    padding-block: 1.5rem;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.9rem;
    color: #6a6a6a;
  }
</style>
