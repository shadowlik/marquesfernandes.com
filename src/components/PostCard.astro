---
/**
 * Blog index card: optional cover thumbnail, then UPPERCASE pink category ->
 * Poppins-bold title -> excerpt -> date.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date: Date;
  lang: string;
  cover?: ImageMetadata;
}
const { href, title, excerpt, date, lang, cover } = Astro.props;
const formatted = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : lang, {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
}).format(date);
---

<article class="card">
  {
    cover && (
      <a class="thumb" href={href} aria-hidden="true" tabindex="-1">
        <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 560px" />
      </a>
    )
  }
  <p class="eyebrow card-date">{formatted}</p>
  <h2 class="title"><a href={href}>{title}</a></h2>
  {excerpt && <p class="excerpt">{excerpt}</p>}
</article>

<style>
  .card {
    padding-block: 1rem;
  }
  .thumb {
    display: block;
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.04);
  }
  .title {
    font-size: 1.6rem;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: var(--tracking-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title a {
    color: var(--color-heading);
  }
  .title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .card-date {
    margin: 0 0 0.4rem;
  }
  .excerpt {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
